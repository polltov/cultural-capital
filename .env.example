# Postgres (любой стандартный; локально: docker compose -f docker-compose.test.yml up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/dev
# Vercel Blob (загрузка обложек)
BLOB_READ_WRITE_TOKEN=
# Админка
ADMIN_LOGIN=
# Хеш: npx tsx scripts/hash-password.ts (bcrypt, cost 12).
# В .env-файлах Next раскрывает $VAR — каждый $ в хеше экранировать как \$ (кавычки НЕ помогают):
#   ADMIN_PASSWORD_HASH=\$2b\$12\$...
# В переменных окружения Vercel экранировать не нужно — вставлять хеш как есть.
ADMIN_PASSWORD_HASH=
# Случайные 32 байта: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Telegram-уведомления об оплаченных заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Публичный URL сайта. На проде — собственный домен: от него зависят return_url оплаты и ссылки в письмах
SITE_URL=http://localhost:3000
# ЮKassa: идентификатор и секретный ключ магазина; для разработки — ТЕСТОВОГО (не боевого)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Код ставки НДС в чеках: 1 = без НДС (подтвердить у бухгалтера)
YOOKASSA_VAT_CODE=1
# Закрывающий чек после экскурсии: off | on (включать только по решению бухгалтера, до первых реальных продаж)
RECEIPT_CLOSING=off
# Resend: отправка писем с билетом (на Vercel ставится интеграцией Marketplace)
RESEND_API_KEY=
# Отправитель писем на подтверждённом в Resend домене, например: Культурная Столица <tickets@example.ru>
MAIL_FROM=
# Секрет ночной задачи /api/cron/nightly; Vercel Cron шлёт его заголовком Authorization: Bearer
# Случайные 32 байта: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
