# Postgres (любой стандартный; локально: docker compose -f docker-compose.test.yml up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/dev
# Объектное хранилище S3 (загрузка обложек). Без него сайт работает, но загрузка фото в админке недоступна.
# На сервере — контейнер в Селектеле (deploy/app.env.example)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Админка
ADMIN_LOGIN=
# Хеш: npx tsx scripts/hash-password.ts (bcrypt, cost 12).
# В .env-файлах Next раскрывает $VAR — каждый $ в хеше экранировать как \$ (кавычки НЕ помогают):
#   ADMIN_PASSWORD_HASH=\$2b\$12\$...
# На сервере (app.env) — наоборот, без \ и в одинарных кавычках: ADMIN_PASSWORD_HASH='$2b$12$...'
ADMIN_PASSWORD_HASH=
# Случайные 32 байта: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Telegram-уведомления об оплаченных заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Публичный URL сайта. На проде — собственный домен: от него зависят ссылки в письмах, Telegram и sitemap.
# Кириллический домен можно записать как есть (https://культурнаястолица.рф): в ссылки он попадёт в punycode
SITE_URL=http://localhost:3000
# ЮKassa: идентификатор и секретный ключ магазина; для разработки — ТЕСТОВОГО (не боевого)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Код ставки НДС в чеках: 1 = без НДС (подтвердить у бухгалтера)
YOOKASSA_VAT_CODE=1
# Закрывающий чек после экскурсии: off | on (включать только по решению бухгалтера, до первых реальных продаж)
RECEIPT_CLOSING=off
# Почта (письма с билетом): SMTP почтового сервиса; без SMTP_HOST письма не отправляются (предупреждение в логе)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Отправитель: имя и адрес того же ящика, что в SMTP_USER, например: Культурная Столица <tickets@example.ru>
MAIL_FROM=
# Письма «вы не завершили оплату» (дневная задача): off | on. По умолчанию выключены — включать, когда юрист подтвердит
ABANDONED_MAIL=off
# Секрет ночной и дневной задач (/api/cron/nightly, /api/cron/daily); расписание (deploy/cron.mjs) шлёт его заголовком Authorization: Bearer
# Случайные 32 байта: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
