# HTTPS для сайта: Caddy сам получает и продлевает сертификат Let's Encrypt для домена из SITE_URL
# (deploy.sh пишет его в punycode в файл .env рядом с compose.yml как SITE_DOMAIN).

(app_proxy_options) {
	# X-Forwarded-For Caddy ставит сам; X-Real-IP от посетителя не пускаем.
	header_up -X-Real-IP
	# Пока приложение перезапускается, запросы ждут новую версию.
	lb_try_duration 30s
	flush_interval -1
}

{$SITE_DOMAIN} {
	# Обложки до 8 МБ уходят формой в админке; Next принимает до 10 МБ, больше не пускаем вовсе.
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@hermitageHTML {
		path /tours/egipetskiy-zal-ermitazha
		method GET HEAD
		header Accept *text/html*
		header Accept-Encoding *zstd*
		not header RSC 1
	}
	# Более длинное окно Zstandard сжимает повтор встроенной обложки в HTML и в данных React.
	handle @hermitageHTML {
		encode zstd gzip
		reverse_proxy app:3000 {
			import app_proxy_options
			header_up Accept-Encoding identity
		}
	}
	handle {
		reverse_proxy app:3000 {
			import app_proxy_options
		}
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
