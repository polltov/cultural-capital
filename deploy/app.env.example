# Настройки боевого сайта на сервере в Селектеле: файл ~/app/app.env (на сервере, в Git не попадает).
# После правки: `docker compose up -d app cron backup` в ~/app (restart новые значения не подхватит); если менялся
# пароль в DATABASE_URL — новая выкладка; SITE_URL и S3_PUBLIC_URL записаны ещё и в образ сайта: их меняют вместе с
# deploy/build.env в репозитории, затем выкладка (deploy.sh не пустит, если они не совпадают).
# ВАЖНО: символ $ портится при запуске. Он допустим только в ADMIN_PASSWORD_HASH (в одинарных кавычках);
# пароли базы и почты — без $.

# Адрес сайта (README, «Домен»): от него ссылки в письмах и Telegram, sitemap и сертификат HTTPS; тот же — в deploy/build.env.
SITE_URL=https://culturaltours.ru

# База PostgreSQL на этом же сервере (контейнер db). Пароль придумать один раз — не короче 24 символов, только латиница
# и цифры: openssl rand -hex 16. Из этой строки его берёт и сама база (deploy.sh), отдельно задавать не нужно.
DATABASE_URL=postgresql://kc:ПАРОЛЬ@db:5432/kc

# Объектное хранилище Селектела (обложки экскурсий и новостей). Контейнер — публичный.
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=kc-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес контейнера (панель → контейнер → «Публичный домен»), без слеша в конце; тот же — в deploy/build.env
S3_PUBLIC_URL=https://xxxxxxxx.selstorage.ru

# Почта (письма с билетом и напоминания): SMTP российского сервиса. Пример — Яндекс 360 для бизнеса:
# ящик tickets@ на домене сайта, пароль приложения (Яндекс ID → Безопасность → Пароли приложений → Почта).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=tickets@culturaltours.ru
SMTP_PASSWORD=
# Отправитель: адрес — тот же ящик, что в SMTP_USER
MAIL_FROM=Культурная Столица <tickets@culturaltours.ru>
# Письма «вы не завершили оплату»: off | on
ABANDONED_MAIL=off

# Вход владельца в админку. Хеш: npx tsx scripts/hash-password.ts — в ОДИНАРНЫХ кавычках.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH='$2b$12$...'
# Случайная строка: openssl rand -hex 32
SESSION_SECRET=
# Секрет расписания задач (ночная и дневная): openssl rand -hex 32
CRON_SECRET=

# Telegram-уведомления об оплаченных заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# С сервера в России api.telegram.org недоступен: запросы идут через посредника на Vercel, того же, что у сайта
# гимназии (svshkola-tg-relay). Ключ — RELAY_KEY из настроек того проекта в Vercel.
TELEGRAM_API_URL=https://svshkola-tg-relay.vercel.app
TELEGRAM_RELAY_KEY=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
RECEIPT_CLOSING=off
