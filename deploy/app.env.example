# Настройки боевого сайта на сервере в Селектеле: файл ~/app/app.env (на сервере, в Git не попадает).
# После правки: `docker compose up -d app cron` в ~/app (restart новые значения не подхватит); если менялись SITE_URL
# или S3_PUBLIC_URL — новая выкладка (они нужны и при сборке).
# ВАЖНО: символ $ портится при запуске и сборке. Он допустим только в ADMIN_PASSWORD_HASH (в одинарных кавычках);
# пароли базы и почты — без $.

# Адрес сайта (README, «Домен»): от него ссылки в письмах и Telegram, sitemap и сертификат HTTPS.
SITE_URL=https://culturaltours.ru

# Управляемая база PostgreSQL Селектела: строка из панели (Облачные базы данных → кластер → Подключение).
# sslmode=verify-full — шифрование и проверка сертификата; сам сертификат root.crt кладётся в ~/app/certs/root.crt.
DATABASE_URL=postgresql://kc:ПАРОЛЬ@АДРЕС_КЛАСТЕРА:5432/kc?sslmode=verify-full

# Объектное хранилище Селектела (обложки экскурсий и новостей). Контейнер — публичный.
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=kc-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес контейнера (панель → контейнер → «Публичный домен»), без слеша в конце
S3_PUBLIC_URL=https://xxxxxxxx.selstorage.ru

# Почта (письма с билетом и напоминания): SMTP российского сервиса. Пример — Яндекс 360 для бизнеса:
# ящик tickets@ на домене сайта, пароль приложения (Яндекс ID → Безопасность → Пароли приложений → Почта).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=tickets@culturaltours.ru
SMTP_PASSWORD=
# Отправитель: адрес — тот же ящик, что в SMTP_USER
MAIL_FROM=Культурная Столица <tickets@culturaltours.ru>
# Письма «вы не завершили оплату»: off | on
ABANDONED_MAIL=off

# Вход владельца в админку. Хеш: npx tsx scripts/hash-password.ts — в ОДИНАРНЫХ кавычках.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH='$2b$12$...'
# Случайная строка: openssl rand -hex 32
SESSION_SECRET=
# Секрет расписания задач (ночная и дневная): openssl rand -hex 32
CRON_SECRET=

# Telegram-уведомления об оплаченных заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
RECEIPT_CLOSING=off
