# ~/app/backup.env — ночные копии базы (контейнер backup, README «Бэкапы»). Только на сервере: chmod 600.
# RESTIC_PASSWORD придумать один раз (openssl rand -hex 32) и сохранить ВНЕ сервера — в менеджере паролей и у владельца:
# без него копии не прочитать, а с потерей сервера потеряется и он.
# Бакет — приватный kc-backups в объектном хранилище Селектела (как svshkola-backups у сайта гимназии);
# адрес S3 — со страницы бакета, ключ — S3-ключ сервисного пользователя с доступом к этому бакету.
RESTIC_REPOSITORY=s3:https://s3.ru-1.storage.selcloud.ru/kc-backups
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
