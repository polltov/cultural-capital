# Настройки, которые попадают в образ сайта при сборке в GitHub Actions (.github/workflows/deploy.yml): адрес сайта
# (ссылки в превью, robots.txt) и публичный адрес хранилища обложек (уменьшенные копии фото). Секретов здесь нет.
# В app.env на сервере те же две строки должны совпадать — deploy.sh это проверяет. Сменить: правка здесь и в app.env,
# затем выкладка.
SITE_URL=https://culturaltours.ru
# Публичный адрес контейнера kc-images: панель Селектела → Объектное хранилище → kc-images → публичный домен.
S3_PUBLIC_URL=
